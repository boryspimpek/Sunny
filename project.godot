[application]

config/name="Sunny"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

EventBus="*res://src/core/event_bus.gd"
GameState="*res://src/core/game_state.gd"
AudioManager="*res://src/audio/audio_manager.gd"
SimpleGrass="*uid://bfq0snth8sj3h"

[editor_plugins]

enabled=PackedStringArray("res://addons/mesh_inspector/plugin.cfg", "res://addons/simplegrasstextured/plugin.cfg")

[importer_defaults]

texture={
&"compress/mode": 2,
&"process/size_limit": 1024
}

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadMotion,"resource_local_to_scene":false,"resource_name":"","device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
